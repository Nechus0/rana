{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rana",
  "version": "2.5.4",
  "identifier": "de.rana.bericht",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rana",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026",
    "category": "Productivity",
    "shortDescription": "Berichte an den Gutachter",
    "longDescription": "Rana erstellt Berichte an den Gutachter für Anträge auf Psychotherapie. Alle Falldaten bleiben verschlüsselt auf dem Gerät.",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "de-DE"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Nechus0/rana/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RkE3N0E2QUIzOUM1MzUKUldRMXhUbXJwbmY2aU1kWnhLNldtd2oyUUw0Y3E0Rk9mVGhIa1VwMmlqODZaSDVTZXlxVlhORFAK"
    }
  }
}

